# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Safe to expose in the browser; row-level security constrains what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. BYPASSES row-level security. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Billed separately from a Claude.ai subscription.
ANTHROPIC_API_KEY=

# --- Google OAuth (Cloud Console -> Credentials -> OAuth 2.0 Client ID) ---
# Used for Calendar + Google Health scopes, requested incrementally after signup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Health ingest (Phase 2) ---
# Shared secret the iOS Shortcuts automation sends so the ingest route can trust it.
HEALTH_INGEST_SECRET=
